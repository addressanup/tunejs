{
  "name": "tunejs",
  "version": "0.0.1-dev.0",
  "private": true,
  "type": "module",
  "description": "Experimental composable sound framework — first-sound development snapshot",
  "files": ["dist", "README.md"],
  "exports": {
    ".": {"types": "./dist/index.d.ts", "default": "./dist/index.js"},
    "./browser": {"types": "./dist/adapters/browser.d.ts", "default": "./dist/adapters/browser.js"},
    "./native": {"types": "./dist/adapters/native.d.ts", "default": "./dist/adapters/native.js"},
    "./presets": {"types": "./dist/presets.d.ts", "default": "./dist/presets.js"},
    "./three": {"types": "./dist/three.d.ts", "default": "./dist/three.js"}
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "dev": "npm run build && node scripts/serve.mjs",
    "experiment:cpp": "node scripts/cpp-experiment.mjs",
    "check:package": "node scripts/check-package.mjs",
    "prepare:native": "node scripts/prepare-native.mjs",
    "check:native": "node scripts/prepare-native.mjs --check"
  },
  "devDependencies": {"typescript": "6.0.3"},
  "engines": {"node": ">=22"}
}
